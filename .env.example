# LLM API Configuration
# Provide either OPENAI_API_KEY or GROQ_API_KEY (or both)
# If both are provided, OpenAI will be used by default unless LLM_PROVIDER is set to 'groq'
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Provider Selection (optional)
# Options: 'openai' or 'groq'
# If not set, will auto-detect based on available API keys (OpenAI preferred)
# LLM_PROVIDER=groq

# Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7

# Database Configuration
DATABASE_URL=sqlite:///data/dynamic_data.db

# Vector Store Configuration
VECTOR_STORE_PATH=vectorstore/faiss_index

# Admin API Configuration (Stage 2: Human-in-the-Loop)
ADMIN_API_URL=http://127.0.0.1:5000
ADMIN_API_PORT=5000

# Application Configuration
LOG_LEVEL=INFO
MAX_TOKENS=500
